{
  "name": "painel-financas",
  "productName": "Painel de Finanças",
  "version": "1.0.0",
  "description": "Painel financeiro - contas a pagar e gestão financeira",
  "main": "main.js",
  "author": "Angelo da Silva Viero",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "start": "electron . --no-sandbox",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "googleapis": "^182.0.0",
    "sqlite3": "^6.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "vs_financas",
    "productName": "Painel de Finanças",
    "asar": true,
    "npmRebuild": true,
    "asarUnpack": [
      "**/node_modules/sqlite3/**/*"
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*",
      "node_modules/**/*",
      "package.json",
      "oauth_credentials.json"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}